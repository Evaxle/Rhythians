{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --no-package-lock",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/discord/sync",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/internal/db-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/rhythia-map-sync",
      "schedule": "0 4 * * *"
    }
  ]
}
