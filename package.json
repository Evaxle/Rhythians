{
  "name": "rhythians",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "bot:start": "ts-node --transpile-only discord-bot/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "2.39.8",
    "clsx": "2.1.1",
    "dayjs": "1.11.10",
    "discord.js": "14.17.0",
    "lucide-react": "0.468.0",
    "next": "16.2.11",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "8.0.7",
    "remark-gfm": "4.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "autoprefixer": "10.4.21",
    "dotenv": "17.2.1",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "7.9.1",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
