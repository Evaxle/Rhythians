generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClipStatus {
  pending
  approved
  rejected
  hidden
  deleted
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum NotificationType {
  clip_approved
  clip_rejected
  comment_reply
  clip_like
  article_published
  announcement
  moderation
  rhp_earned
  map_approved
  map_rejected
  rank_change
  tag_setup
}

enum ChallengeMapStatus {
  pending
  approved
  rejected
  hidden
}
